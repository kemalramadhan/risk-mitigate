# ==== Konfigurasi untuk deployment Docker ====
# Salin file ini menjadi .env  (Windows: copy .env.docker.example .env)
# lalu ganti password database di bawah.

APP_NAME="Risk Mitigate"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# --- Database (dipakai container app DAN service db) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=risk_mitigate
DB_USERNAME=risk_mitigate
DB_PASSWORD=ganti_password_ini
DB_ROOT_PASSWORD=ganti_root_password_ini

# --- Sesi ---
SESSION_DRIVER=database
# Set true bila HANYA diakses lewat Cloudflare (HTTPS). Biarkan false agar
# pengujian lokal via http://localhost:8000 tetap bisa login.
SESSION_SECURE_COOKIE=false

# --- Engine AHP (Python di dalam container) ---
AHP_PYTHON=/usr/bin/python3

# --- Seed data demo saat pertama kali (true/false) ---
# true = ikut membuat akun demo (budi@demo.com dll, password: password)
SEED_DEMO=true
